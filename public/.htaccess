<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable directory browsing
    Options -Indexes

    # Block access to hidden files
    RewriteRule "(^|/)\." - [F]

    # Handle Front Controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
