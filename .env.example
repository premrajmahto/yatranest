APP_NAME="YatraNest - Tour & Travel Booking"
APP_ENV=development
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_SECRET="generate_a_random_32_character_string_here"

# Database Configuration (MySQL 8+ / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yatranest_db
DB_USER=root
DB_PASS=

# Razorpay Payment Gateway (Test Mode credentials)
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_sampleKey12345
RAZORPAY_KEY_SECRET=rzp_test_secretSample67890
RAZORPAY_WEBHOOK_SECRET=whsec_sampleRazorpayWebhookSecret
RAZORPAY_MODE=test

# Email Configuration (PHPMailer / SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yatranest.com
MAIL_FROM_NAME="YatraNest Holidays"

# Session & Booking Settings
SESSION_LIFETIME=7200
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL="₹"
HOLD_EXPIRATION_MINUTES=15
